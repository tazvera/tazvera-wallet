+
+/* ---------- accessibility & polish (added 2026-11) ---------- */
+
+/* 1. Respect "reduce motion": the OS setting is an accessibility need, not a preference.
+      Every animation and transition in this file becomes instant, nothing else changes. */
+@media (prefers-reduced-motion: reduce){
+  *,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}
+  .anim{animation:none!important}
+}
+
+/* 2. Visible keyboard focus. Without this, a Bluetooth keyboard, a switch device or a screen reader
+      user has no idea which button is selected. Mouse and touch taps are not affected. */
+:focus{outline:none}
+:focus-visible{outline:2px solid var(--green);outline-offset:2px;border-radius:12px}
+.k:focus-visible,.kp .k:focus-visible{border-radius:50%;outline-offset:3px}
+
+/* 3. Hindi needs more room: Devanagari matras sit above and below the baseline and clip at tight
+      line heights. Only headings, buttons and sheet titles — body text already has enough. */
+html[lang="hi"] h1,html[lang="hi"] h3,html[lang="hi"] .sht,html[lang="hi"] .pt,
+html[lang="hi"] .btn,html[lang="hi"] .btnw,html[lang="hi"] .opt b,html[lang="hi"] .srow b{line-height:1.5}
+
+/* 4. Long Hindi/Marathi button labels must wrap, never spill outside the button. */
+.btn,.btnw,.b2{white-space:normal;word-break:break-word;text-align:center}
