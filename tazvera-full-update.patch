 .sc{margin-top:12px;display:flex;gap:12px;align-items:flex-start;border-radius:16px;padding:12px 14px}
@@ -437,3 +437,45 @@ html[data-theme=dark] .aim.u .aib{background:linear-gradient(135deg,#14C8A8,#0EA
 #splash.calm .pc,#splash.calm .sp-tile,#splash.calm .sp-word i,#splash.calm .sp-tag,#splash.calm .sp-glow{opacity:1!important;transform:none!important}
 #splash.calm .sp-glow{transform:translate(-50%,-50%)!important}
 #splash.calm .sp-ring,#splash.calm .sp-shine{opacity:0!important}
+
+/* ---------- accessibility & polish (added 2026-11) ---------- */
+
+/* 1. Respect "reduce motion": the OS setting is an accessibility need, not a preference.
+      Every animation and transition in this file becomes instant, nothing else changes. */
+@media (prefers-reduced-motion: reduce){
+  *,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}
+  .anim{animation:none!important}
+}
+
+/* 2. Visible keyboard focus. Without this, a Bluetooth keyboard, a switch device or a screen reader
+      user has no idea which button is selected. Mouse and touch taps are not affected. */
+:focus{outline:none}
+:focus-visible{outline:2px solid var(--green);outline-offset:2px;border-radius:12px}
+.k:focus-visible,.kp .k:focus-visible{border-radius:50%;outline-offset:3px}
+
+/* 3. Hindi needs more room: Devanagari matras sit above and below the baseline and clip at tight
+      line heights. Only headings, buttons and sheet titles — body text already has enough. */
+html[lang="hi"] h1,html[lang="hi"] h3,html[lang="hi"] .sht,html[lang="hi"] .pt,
+html[lang="hi"] .btn,html[lang="hi"] .btnw,html[lang="hi"] .opt b,html[lang="hi"] .srow b{line-height:1.5}
+
+/* 4. Long Hindi/Marathi button labels must wrap, never spill outside the button. */
+.btn,.btnw,.b2{white-space:normal;word-break:break-word;text-align:center}
+
+/* ---------- press feedback, and no long-press image menu (added 2026-11) ---------- */
+
+/* On Android a long press on any picture opens "Copy image / Download image / Share image /
+   Open in Chrome". Inside a wallet that menu is noise, and it looks broken. Decorative images and
+   icons must not be selectable, draggable or long-pressable: taps go to the button around them. */
+body{-webkit-tap-highlight-color:transparent}
+img{-webkit-touch-callout:none;-webkit-user-drag:none;user-select:none;-moz-user-select:none;pointer-events:none}
+svg{-webkit-touch-callout:none;user-select:none}
+/* long press on text must not start a text selection either (except where the user may copy) */
+.btn,.btnw,.b2,.opt,.srow,.chip2,.max,.ib,.k,.it,.m,.sht,.lb,.lb2,.lb3,.note2,.err,.kv span,.kv b{-webkit-user-select:none;user-select:none}
+.cpbox,.addr,input,textarea{-webkit-user-select:text;user-select:text}
+
+/* real press feedback: the button sinks a little, so a tap feels answered even with vibration off */
+.btn,.btnw,.b2,.opt,.srow,.chip2,.max,.ib,.k,.tab{transition:transform .09s ease,filter .09s ease}
+.btn:active,.btnw:active,.b2:active,.opt:active,.srow:active,.chip2:active,.max:active,.ib:active,.k:active,.tab:active{transform:scale(.97);filter:brightness(.94)}
+@media (prefers-reduced-motion: reduce){
+  .btn:active,.btnw:active,.b2:active,.opt:active,.srow:active,.chip2:active,.max:active,.ib:active,.k:active,.tab:active{transform:none;filter:brightness(.9)}
+}
